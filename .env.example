# ---------------------------------------------------------------------------
# EcoTrace environment configuration
# Copy to .env.local and fill in your own values.
# ---------------------------------------------------------------------------

# MySQL (Docker compose default)
MYSQL_URL=mysql://ecotrace_user:ecotrace_pass@127.0.0.1:3307/ecotrace

# MongoDB (Docker compose default). Replace with your MongoDB Atlas SRV string.
MONGODB_URI=mongodb://127.0.0.1:27017/ecotrace

# Secret used to sign the HttpOnly session JWT. Use a long random value.
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Optional: base URL used by the smoke-test script
BASE_URL=http://localhost:3000
